<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows GyroTube's local Rust AudioStreamer (http://127.0.0.1:<port>/stream/...)
  to serve cached/proxied audio chunks to the Android WebView while keeping
  cleartext traffic disabled for all external internet domains.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
</network-security-config>
