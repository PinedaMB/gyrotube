{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gyro",
  "version": "1.1.0",
  "identifier": "com.github.gyrotube.GyroTube",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gyro",
        "width": 1220,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data: blob: https: http://127.0.0.1:*; media-src 'self' blob: https: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Music",
    "license": "MIT",
    "shortDescription": "Fast, modern YouTube Music client with lyrics, crossfade, and SPIN Mode",
    "longDescription": "Gyro is a cross-platform music streaming client built with Rust, Tauri v2, and Svelte 5, featuring synced lyrics, dual-deck crossfade, local playlists, and collaborative SPIN sessions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"],
        "files": {
          "/usr/share/metainfo/io.github.pinedamb.gyro.metainfo.xml": "linux/io.github.pinedamb.gyro.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/io.github.pinedamb.gyro.metainfo.xml": "linux/io.github.pinedamb.gyro.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQkRGQjQ2RDFCMDY0RkIKUldUN1pMRFJSdnU5L0l4aUN4bjZlVE93UlJ1NElmRkFhRVIxaCthVHNSRzFBSzlMU2Y3R1Z0UDYK",
      "endpoints": [
        "https://github.com/PinedaMB/gyrotube/releases/latest/download/latest.json"
      ]
    }
  }
}
