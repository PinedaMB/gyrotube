{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GyroTube",
  "version": "0.1.0",
  "identifier": "com.github.gyrotube.GyroTube",
  "build": {
    "beforeDevCommand": "node -e \"const fs=require('fs'),cp=require('child_process');const d=fs.existsSync('ui')?'ui':'../ui';cp.execSync('pnpm --dir '+d+' dev',{stdio:'inherit'})\"",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node -e \"const fs=require('fs'),cp=require('child_process');const d=fs.existsSync('ui')?'ui':'../ui';cp.execSync('pnpm --dir '+d+' build',{stdio:'inherit'})\"",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GyroTube",
        "width": 1220,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Fast, modern YouTube Music client with lyrics, crossfade, and SPIN Mode",
    "longDescription": "GyroTube is a cross-platform music streaming client built with Rust, Tauri v2, and Svelte 5, featuring synced lyrics, dual-deck crossfade, local playlists, and collaborative SPIN sessions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
