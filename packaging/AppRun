#!/bin/sh
set -eu
APPDIR=${APPDIR:-$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)}
export APPDIR
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GIO_EXTRA_MODULES="$APPDIR/usr/lib/gio/modules"
export GST_PLUGIN_SYSTEM_PATH_1_0="$APPDIR/usr/lib/gstreamer-1.0"
export GST_PLUGIN_SCANNER="$APPDIR/usr/libexec/gst-plugin-scanner"

pixbuf_cache=$(mktemp)
trap 'rm -f "$pixbuf_cache"' EXIT
escaped_appdir=$(printf '%s' "$APPDIR" | sed 's/[&|\\]/\\&/g')
sed "s|@APPDIR@|$escaped_appdir|g" "$APPDIR/usr/lib/gdk-pixbuf-2.0/loaders.cache" > "$pixbuf_cache"
export GDK_PIXBUF_MODULE_FILE="$pixbuf_cache"

# Limit the bundled library path to this process. External yt-dlp and Node use host libraries.
/lib64/ld-linux-x86-64.so.2 --library-path "$APPDIR/usr/lib" "$APPDIR/usr/bin/gyrotube" "$@"
